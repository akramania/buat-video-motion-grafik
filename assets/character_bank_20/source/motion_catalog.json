  "usage": {
    "pose": "poseState(poseId, character)",
    "motion": "sampleMotion(motionId, seconds, character, {loop:false})",
    "duration": "durationForCharacter(motionId, character)",
    "transition": "transitionState(previousState, nextState, seconds, duration): use for compatible standing gestures. For posture changes use dedicated sit_down/stand_up/kneel_down clips to preserve foot contacts.",
    "looping": "Native loop actions repeat with matching seams. Explicit loop:true on finite actions uses a continuous ping-pong over 2 x duration to avoid pose jumps.",
