{
  "name": "km-hyperframes-runtime",
  "version": "2.0.0",
  "private": true,
  "description": "Pinned reusable HyperFrames, GSAP, Three.js, React and Remotion runtime",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "hyperframes lint .",
    "render": "hyperframes render . --output renders/demo.mp4 --fps 30 --workers 1"
  },
  "dependencies": {
    "hyperframes": "0.9.4",
    "gsap": "3.15.0",
    "three": "0.187.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@remotion/bundler": "4.0.540",
    "puppeteer-core": "25.16.0"
  }
}
