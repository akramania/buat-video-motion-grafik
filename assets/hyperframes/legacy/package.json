{
  "name": "km-hyperframes-runtime",
  "version": "1.0.0",
  "private": true,
  "description": "Pinned offline-capable HyperFrames/GSAP render runtime for Kelas Multimedia",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "hyperframes lint .",
    "render": "hyperframes render . --output renders/demo.mp4 --fps 30 --workers 1"
  },
  "dependencies": {
    "@sparticuz/chromium": "138.0.2",
    "gsap": "3.14.2",
    "hyperframes": "0.8.185",
    "puppeteer-core": "25.15.0"
  }
}
